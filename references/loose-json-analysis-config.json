  "privacy": {
    "sensitive_field_name_patterns": [
      {
        "target": "normalized",
        "pattern": "(?:^|_)(?:email|e_mail|phone|mobile|address|idcard|identity|realname|username|account|password|passwd|token|openid|deviceid|imei|mac)(?:$|_)"
      },
      {
        "target": "normalized",
        "pattern": "(?:idcard|realname|username|openid|deviceid)"
      },
      {
        "target": "raw",
        "pattern": "(?:邮箱|手机|电话|地址|身份证|实名|用户名|账号|密码|令牌|设备号)"
      }
    ]
  }
}
