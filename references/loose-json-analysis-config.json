{
  "schema_version": "1.0",
  "scan": {
    "relative_roots": [
      "."
    ],
    "extension": ".json"
  },
  "expected": {
    "file_count": null,
    "total_bytes": null
  },
  "decoding_order": [
    "utf-8-bom",
    "utf-8",
    "gb18030"
  ],
  "naming": {
    "pattern": "^d_(?P<module>[^.]+)\\.py\\.(?P<table>[^.]+)\\.json$",
    "module_group": "module",
    "table_group": "table",
    "ignore_case": true,
    "unmatched_module": ""
  },
  "limits": {
    "sample_key_count": 20,
    "sample_key_characters": 500,
    "error_characters": 300,
    "largest_table_count": 30,
    "module_top_count": 30,
    "sensitive_field_top_count": 30,
    "system_example_count": 5,
    "matched_keyword_top_count": 20
  },
  "record_count_buckets": [
    {
      "min": 0,
      "max": 0,
      "label": "0"
    },
    {
      "min": 1,
      "max": 1,
      "label": "1"
    },
    {
      "min": 2,
      "max": 9,
      "label": "2-9"
    },
    {
      "min": 10,
      "max": 99,
      "label": "10-99"
    },
    {
      "min": 100,
      "max": 999,
      "label": "100-999"
    },
    {
      "min": 1000,
      "max": 9999,
      "label": "1000-9999"
    },
    {
      "min": 10000,
      "max": null,
      "label": ">=10000"
    }
  ],
  "sampling": {
    "sha256_sample_size": 20,
    "sha256_seed": "game-analysis-loose-json-v1"
  },
  "outputs": {
    "inventory_csv": "json-data-inventory.csv",
    "summary_json": "summary.json",
    "analysis_markdown": "analysis.md"
  },
  "system_candidates": {
    "AI/行为": [
      "ai",
      "behavior",
      "behaviour",
      "strategy",
      "behaviortree",
      "行为",
      "策略"
    ],
    "NPC/角色": [
